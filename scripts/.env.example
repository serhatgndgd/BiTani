# BiTanı KÜB Pipeline — Ortam Değişkenleri
# cp .env.example .env  →  doldurup kaydet

# ── Zorunlu ────────────────────────────────────────────
SUPABASE_URL=https://jabggkqjiwctwdbiipho.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

GROQ_API_KEY=your_groq_api_key_here
# https://console.groq.com → API Keys

# ── İsteğe Bağlı ───────────────────────────────────────
MAX_MEDICATIONS=10        # test modu; üretimde sil
GROQ_RPM=30               # free tier=30, paid=daha yüksek
CONCURRENT_DOWNLOADS=10   # paralel PDF indirme (max 20)
REPROCESS_ALL=0           # 1 = işlenmiş ilaçları yeniden işle
KUB_DEBUG=0               # 1 = PDF önizleme yazdır
